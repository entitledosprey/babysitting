# Copy to .env next to docker-compose.yml and fill in the values.
# The file is read at container start; run `docker compose up -d` to apply changes.

# --- Administration ---------------------------------------------------------
# Comma-separated emails granted the /admin console. These accounts must still
# register normally; this only grants the admin role. Deliberately not a
# database flag, so the role cannot be granted from inside the app.
ADMIN_EMAILS=you@example.com

# Used for the "Open the full log" link in report emails.
APP_BASE_URL=https://babysitting.entitledosprey.com

# --- Outgoing mail ----------------------------------------------------------
# The daily report is emailed to every parent in the family when a session is
# closed out. Leave SMTP_HOST empty to disable sending; the app degrades
# gracefully and records each attempt as "skipped" in the admin email log.

SMTP_HOST=

# These two must agree. Only two combinations are valid:
#
#   SMTP_PORT=465  with  SMTP_SECURE=true    (TLS from the first byte)
#   SMTP_PORT=587  with  SMTP_SECURE=false   (plaintext, upgraded via STARTTLS)
#
# Getting this wrong fails with "Greeting never received", which looks like a
# network problem but is not. Port 465 is forced secure regardless, and a
# mismatch is reported in Admin → Overview.
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

# The angle brackets are required when you include a display name:
#   SMTP_FROM=Sitter Log <no-reply@entitledosprey.com>   correct
#   SMTP_FROM=Sitter Log no-reply@entitledosprey.com     invalid
# Must be an address the SMTP account is allowed to send as.
SMTP_FROM=Sitter Log <no-reply@entitledosprey.com>
